# Copy to .env at the project root. Every value below is a default — you only
# need to set the ones you want to change.

# --- where the trained artifacts live ----------------------------------------
# Paths are relative to the project root unless you give an absolute path.
MODEL_DIR=models
# Comma-separated, first match wins. cnn_best.pt is the BEST-val-loss checkpoint
# the notebook saves; cnn_model.pt / emg_cnn.pt are last-epoch weights.
CNN_PATH=cnn_best.pt,cnn_model.pt,emg_cnn.pt
FLORENCE_DIR=models/florence_finetuned
FLORENCE_HEAD_PATH=models/florence_als_head.pt
META_PATH=models/meta_learner.pkl

SAMPLE_DIR=sample_signals
OUTPUT_DIR=outputs

# --- signal / preprocessing ---------------------------------------------------
# FS is the sampling rate the bandpass filter assumes. The notebook trained with
# FS=1000 ("assumed sampling rate for EMG-like signal"). The saved weights are
# tied to that preprocessing, so changing FS without retraining will quietly
# degrade results. See README > Sampling rate.
FS=1000
BANDPASS_LOW=5
BANDPASS_HIGH=450
BANDPASS_ORDER=4

SIGNAL_LENGTH=23437
# 0 = reject any other length. Set e.g. 100 to pad/trim within 100 points.
LENGTH_TOLERANCE=0
N_SEGMENTS=10

# --- runtime ------------------------------------------------------------------
DEVICE=auto          # auto | cpu | cuda
SEED=42

ENABLE_FLORENCE=1        # may the VLM be used at all
FLORENCE_DEFAULT=0       # run it when the request does not say either way
LOAD_FLORENCE_AT_STARTUP=1

# --- Multi-Provider AI Copilot & Explanation Smoothing -----------------------
# Provider: gemini | openai | anthropic | groq | openrouter | ollama | local
ENABLE_LLM=1
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite

# Provider credentials (configure via UI Settings modal or environment):
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEMO_MODE=0

# --- server -------------------------------------------------------------------
# development | production. Production hides /docs and /openapi.json, turns on
# HSTS defaults, and refuses a wildcard CORS origin.
ENV=development

MAX_UPLOAD_MB=25
MAX_BATCH_SIZE=16
ARTIFACT_TTL_MINUTES=120
# How often the background worker deletes expired images, PDFs and results.
SWEEP_INTERVAL_SECONDS=300
# Delete every generated artifact on shutdown (handy for ephemeral containers).
PURGE_ON_SHUTDOWN=0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- logging -------------------------------------------------------------------
LOG_LEVEL=INFO
# 1 = one JSON object per line for a log collector. Defaults to on in production.
JSON_LOGS=0

# --- rate limiting -------------------------------------------------------------
# Per client IP, PER WORKER PROCESS. With 2 workers the effective ceiling is
# double this. See DEPLOYMENT.md section 3.
RATE_LIMIT=20
RATE_LIMIT_WINDOW=60

# --- security ------------------------------------------------------------------
# Only meaningful over TLS; harmful on plain-HTTP localhost.
ENABLE_HSTS=0
# Comma-separated hostnames this app will answer for. Empty = any.
TRUSTED_HOSTS=
# 1 = believe X-Forwarded-For. Turn on ONLY behind a proxy you control, or
# clients can forge their IP and bypass the rate limiter.
TRUST_PROXY_HEADERS=0
# CONTENT_SECURITY_POLICY=   # override only if you self-host the fonts

# --- frontend ------------------------------------------------------------------
# Serve the built SPA from FastAPI (what the Docker image does).
SERVE_FRONTEND=1
FRONTEND_DIR=frontend/dist

# --- gunicorn ------------------------------------------------------------------
# Each worker loads its OWN copy of every model. Read DEPLOYMENT.md section 3
# before raising this.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
BIND=0.0.0.0:8000
