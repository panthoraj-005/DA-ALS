# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure your variables before running.
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
JSON_LOGS=0
SERVE_FRONTEND=0

# Hardware & Compute
# Options: cpu, cuda, mps, directml
DEVICE=cpu

# Multimodal Screening AI Models
CNN_PATH=../models/cnn_best.pt
FLORENCE_HEAD_PATH=../models/florence_als_head.pt
META_LEARNER_PATH=../models/meta_learner.pkl
SAMPLE_DIR=../sample_signals
OUTPUT_DIR=../outputs

# Explainability & LLM Integration
ENABLE_EXPLANATIONS=1
ENABLE_LLM=1
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite

# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
